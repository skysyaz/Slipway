// Slipway — Prisma schema
// SQLite-backed store for the self-hosted deployment platform.
// Mirrors src/lib/slipway/types.ts plus auth/integrations/scheduling.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Auth (NextAuth v4 adapter-compatible, simplified)
// ---------------------------------------------------------------------------

model User {
  id           String   @id @default(cuid())
  username     String   @unique
  email        String?  @unique
  passwordHash String?
  role         String   @default("admin") // admin | user
  displayName  String?
  totpSecret   String?
  totpEnabled  Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  accounts Account[]
  sessions Session[]
  tokens   ApiToken[]
  activity ActivityEvent[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  provider          String // credentials | github | gitlab | oidc | saml
  providerAccountId String
  type              String @default("oauth")
  refreshToken String?
  accessToken  String?
  expiresAt    Int?
  scope       String?
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ---------------------------------------------------------------------------
// Core platform entities
// ---------------------------------------------------------------------------

model Project {
  id                 String   @id @default(cuid())
  name               String
  slug               String   @unique
  source             String   // git | folder | compose
  repoUrl            String?
  folderPath         String?
  composePath        String?
  stack              String   // StackKind
  stackLabel         String
  framework          String?
  environment        String   // production | staging | preview
  status             String   @default("stopped") // ServiceStatus
  lastDeployedAt     DateTime?
  url                String?
  description        String?
  region             String   @default("local")
  memoryMb           Int      @default(512)
  cpuMilli           Int      @default(400)
  replicas           Int      @default(1)
  minReplicas        Int      @default(1)
  maxReplicas        Int      @default(6)
  monorepo           Boolean  @default(false)
  monorepoPath       String?
  // deploy policy
  autoDeploy         Boolean  @default(true)
  requireTests       Boolean  @default(false)
  autoRollback       Boolean  @default(true)
  pauseDuringWindows Boolean  @default(false)
  prPreviews         Boolean  @default(true)
  buildCmd           String?
  startCmd           String?
  // docker linkage
  dockerImage        String?
  dockerContainerId  String?
  // env metadata cached for lists
  envVarsCount       Int      @default(0)
  monthlyDeploys     Int      @default(0)
  successRate        Float    @default(100)
  paused             Boolean  @default(false)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  services   Service[]
  domains    Domain[]
  envVars    EnvVar[]
  deployments Deployment[]
  databases  DatabaseInstance[]
  volumes    Volume[]
  activity   ActivityEvent[]
  notifications Notification[]
  backups    BackupRecord[]
}

model Service {
  id                String  @id @default(cuid())
  projectId         String
  name              String
  kind              String // app | worker | database | cache | cron
  status            String  @default("stopped")
  image             String
  port              Int?
  replicas          Int     @default(1)
  memoryMb          Int     @default(256)
  cpuMilli          Int     @default(200)
  uptimeSeconds     Int     @default(0)
  restarts          Int     @default(0)
  dockerContainerId String?
  project           Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  metrics MetricSample[]
}

model Domain {
  id        String  @id @default(cuid())
  projectId String
  hostname  String
  type      String  @default("primary") // primary | api | redirect | preview
  ssl       String  @default("disabled") // managed | custom | pending | disabled
  sslExpiry DateTime?
  https     Boolean @default(false)
  // active | pending | failed | action-required (P1: app up, routing/TLS needs fix)
  status    String  @default("pending")
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model EnvVar {
  id        String @id @default(cuid())
  projectId String
  key       String
  value     String
  scope     String @default("all") // all | production | staging | preview
  masked    Boolean @default(false)
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, key, scope])
}

model Deployment {
  id            String   @id @default(cuid())
  // ponytail: nullable so a SHARED database provision (no project) can still be
  // recorded as a Deployment and show in the Deployments view. On project delete
  // the row is kept (SetNull) rather than cascaded — a db provision log survives
  // the project it was briefly linked to.
  projectId     String?
  // ponytail: distinguishes an app deploy (project) from a database provision,
  // so the Deployments view can render the right icon + avoid a fake pipeline.
  kind          String   @default("project") // project | database
  commitSha     String   @default("")
  commitMessage String  @default("")
  branch        String   @default("main")
  author        String   @default("you")
  environment   String   @default("production")
  status        String   @default("queued") // DeploymentStatus
  createdAt     DateTime @default(now())
  finishedAt    DateTime?
  durationMs    Int?
  rollbackOfId  String?
  url           String?
  // ponytail: the exact image this deployment released, e.g.
  // `nginx:1.27` or `slipway-web:cmf3x9k2`. Recorded so a ROLLBACK can be real:
  // rollback re-runs the container from a previous deployment's image. Before
  // this existed, rollback could only write a "healthy" record and change
  // nothing, because nothing knew what to roll back TO. Null for compose
  // deploys (compose owns its own images) and for pre-existing rows.
  image         String?
  // ponytail: the real reason a deploy failed — the failing step's stderr tail
  // mapped to a human cause + action (Bug 3). Empty on success. Surfaced in the
  // deploy view instead of a generic "error".
  error         String?
  // OpenShip P3: frozen build/start/port/env snapshot (JSON) for exact
  // redeploy/rollback. Null when SLIPWAY_FF_DEPLOY_SNAPSHOT is off or legacy.
  configSnapshot String?
  // OpenShip P1: per-domain routing warnings (JSON string[]) — deploy stayed
  // healthy; operator must fix DNS/proxy. Null when none.
  routeWarnings  String?
  // OpenShip P4: changed paths for this deploy (JSON string[]), when known.
  changedPaths   String?
  forceAll       Boolean @default(false)
  project       Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  steps         DeploymentStep[]

  @@index([projectId])
}

model DeploymentStep {
  id          String  @id @default(cuid())
  deploymentId String
  stage       String  // PipelineStage
  label       String
  status      String  // DeploymentStatus
  startedAt   DateTime?
  finishedAt  DateTime?
  durationMs  Int?
  logLines    Int     @default(0)
  // ponytail: the failing step's captured stdout/stderr tail (Bug 3). Null on
  // success or for steps that didn't run.
  log         String?
  order       Int     @default(0)
  deployment  Deployment @relation(fields: [deploymentId], references: [id], onDelete: Cascade)

  @@index([deploymentId])
}

model DatabaseInstance {
  id                String   @id @default(cuid())
  name              String
  kind              String // DatabaseKind
  version           String
  status            String   @default("stopped")
  projectId         String?
  host              String
  port              Int      @default(5432)
  storageGb         Int      @default(20)
  usedGb            Float    @default(0)
  connections       Int      @default(0)
  maxConnections    Int      @default(200)
  backupsEnabled    Boolean  @default(true)
  region            String   @default("local")
  dockerContainerId String?
  // ponytail: credentials stored plaintext in local SQLite. The manager must be
  // able to reveal them (same as Coolify). Encrypt at rest when a secrets
  // backend / multi-node lands — not worth it for single-node self-host now.
  username     String? // generated on provision (slipway / root / sa / none for redis)
  password     String? // generated on provision
  dbName       String? // the database name inside the engine (postgres/mysql/mongo)
  internalPort Int?    // engine's in-container port (5432, 3306, …)
  // ponytail: environment tag so a DB provisioned under Staging shows as
  // Staging and the Databases view filters by the global env toggle (bug 6).
  // Nullable: pre-existing rows have no env and only show under "All".
  environment  String? // production | staging | preview
  createdAt    DateTime @default(now())
  project      Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
}

model Volume {
  id              String  @id @default(cuid())
  name            String
  projectId       String?
  mountPath       String  @default("/data")
  sizeGb          Int     @default(20)
  usedGb          Float   @default(0)
  type            String  @default("ssd") // ssd | hdd | nfs
  server          String  @default("local")
  encrypted       Boolean @default(true)
  dockerVolumeName String?
  project         Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
}

model Server {
  id            String   @id @default(cuid())
  name          String   @unique
  hostname      String
  ip            String
  role          String   @default("worker") // manager | worker | standalone
  status        String   @default("offline") // online | offline | degraded
  os            String   @default("Ubuntu 24.04 LTS")
  cpuCores      Int      @default(4)
  memoryGb      Int      @default(16)
  diskGb        Int      @default(200)
  diskUsedGb    Int      @default(0)
  dockerVersion String   @default("")
  region        String   @default("local")
  uptimeHours   Int      @default(0)
  sshUser       String?
  sshKeyId      String?
  joinedAt      DateTime?
  createdAt     DateTime @default(now())
}

model SshKey {
  id        String   @id @default(cuid())
  name      String
  publicKey String
  scope     String   @default("cluster") // cluster | repo
  fingerprint String?
  createdAt DateTime @default(now())
}

model Registry {
  id        String   @id @default(cuid())
  name      String
  url       String
  auth      String   @default("anonymous") // token | basic | anonymous
  token     String?
  username  String?
  password  String?
  createdAt DateTime @default(now())
}

model Webhook {
  id        String   @id @default(cuid())
  url       String
  events    String   // JSON array of event names
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
}

model ApiToken {
  id         String   @id @default(cuid())
  name       String
  scope      String   @default("read") // read | deploy | admin
  tokenHash  String   @unique
  // sha256(token) index for O(1) lookup (no per-miss bcrypt table scan).
  // NULL for rows minted before the index existed (they still auth via the
  // bcrypt fallback and are back-filled on first use).
  lookupHash String?  @unique
  lastUsedAt DateTime?
  createdAt  DateTime @default(now())
  user       User?    @relation(fields: [userId], references: [id])
  userId     String?
}

model BackupRecord {
  id            String   @id @default(cuid())
  target        String
  targetKind    String   // database | volume | project
  status        String   @default("running") // completed | running | failed | scheduled | expired
  sizeMb        Int      @default(0)
  startedAt     DateTime @default(now())
  finishedAt    DateTime?
  durationMs    Int?
  schedule      String?
  retentionDays Int      @default(14)
  server        String   @default("local")
  // ponytail: the archive this record produced, inside the `slipway-backups`
  // Docker volume (e.g. `db-orders-2026-07-28T10-00-00-000Z.sql.gz`). Recorded
  // so the UI can tell an operator exactly what exists and where, instead of
  // showing a Download button that never downloaded anything.
  fileName      String?
  projectId     String?
  project       Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
}

model BackupSchedule {
  id            String   @id @default(cuid())
  target        String
  targetKind    String
  schedule      String   // cron
  retentionDays Int      @default(14)
  active        Boolean  @default(true)
  createdAt     DateTime @default(now())
}

model Notification {
  id        String   @id @default(cuid())
  title     String
  body      String   @default("")
  level     String   @default("info") // info | success | warning | error
  kind      String   @default("system") // deploy | backup | ssl | server | security | system
  read      Boolean  @default(false)
  ts        DateTime @default(now())
  projectId String?
  project   Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
}

model ActivityEvent {
  id        String   @id @default(cuid())
  ts        DateTime @default(now())
  actor     String   @default("you")
  kind      String   // deploy | rollback | scale | domain | database | backup | env | server
  message   String
  projectId String?
  project   Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  userId    String?
  user      User?     @relation(fields: [userId], references: [id])
}

model Integration {
  id     String @id @default(cuid())
  kind   String // slack | email | discord | pagerduty | telegram | teams
  config String // JSON
  active Boolean @default(true)
}

model MetricSample {
  id         String   @id @default(cuid())
  serviceId  String?
  containerId String?
  ts         DateTime @default(now())
  cpu        Float    @default(0)
  memory     Float    @default(0)
  netIn      Float    @default(0)
  netOut     Float    @default(0)
  service     Service? @relation(fields: [serviceId], references: [id], onDelete: SetNull)
}

model Setting {
  key   String @id
  value String
}

// Capped ring buffer for simulated/non-Docker logs and persisted runtime logs.
model LogLine {
  id        String   @id @default(cuid())
  ts        DateTime @default(now())
  level     String   @default("info") // debug | info | warn | error | system
  service   String   @default("app")
  message   String
  projectId String?
  containerId String?

  @@index([ts])
}